{
  "enabled": true,
  "source": {
    "type": "com.cirruslink.mqtt.engine.gateway.mqtt.source",
    "config": {
      "topic": "icc26/site1/upstream/vibration-gw/response/waveform",
      "qos": 1
    }
  },
  "sourceEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "handlers": [
    {
      "enabled": true,
      "type": "ignition.script",
      "config": {
        "userCode": "\tfor event in events:\n\t\tvibsim.route_waveform(event.data)\n"
      },
      "failureStrategy": {
        "type": "ABORT",
        "retryPolicy": {
          "type": "FIXED",
          "retryCount": 0,
          "delayMs": 1000,
          "maxDelayMs": 1000,
          "multiplier": 1,
          "abort": true
        }
      }
    }
  ],
  "batch": {
    "debounceMs": 100,
    "maxWaitMs": 1000,
    "maxQueueSize": 0,
    "overflow": "DROP_OLDEST"
  },
  "filter": {
    "enabled": false,
    "userCode": "\treturn True"
  },
  "transform": {
    "enabled": false,
    "userCode": "\treturn event.data"
  },
  "transformEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "onError": {
    "enabled": false,
    "userCode": ""
  }
}