{
  "enabled": true,
  "source": {
    "type": "com.cirruslink.mqtt.engine.gateway.mqtt.source",
    "config": {
      "topic": "icc26/site1/upstream/vibration-gw/cmd/collect",
      "qos": 1
    }
  },
  "sourceEncoder": {
    "type": "ignition.jsonObject",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "handlers": [
    {
      "enabled": true,
      "type": "com.cirruslink.mqtt.transmission.gateway.mqtt.handler",
      "config": {
        "serverName": "chariot_broker",
        "topic": "icc26/site1/upstream/vibration-gw/response/waveform",
        "qos": 1,
        "retained": false
      },
      "failureStrategy": {
        "type": "ABORT",
        "retryPolicy": null
      }
    }
  ],
  "batch": {
    "debounceMs": 100,
    "maxWaitMs": 1000,
    "maxQueueSize": 0,
    "overflow": "DROP_OLDEST"
  },
  "filter": {
    "enabled": false,
    "userCode": "\treturn True"
  },
  "transform": {
    "enabled": true,
    "userCode": "\treturn vibsim.build_collect_response(event.data)\n"
  },
  "transformEncoder": {
    "type": "ignition.string",
    "properties": {
      "encoding": "UTF-8"
    }
  },
  "onError": {
    "enabled": false,
    "userCode": ""
  }
}