# ─────────────────────────────────────────────────────────────────────────────
# ICC 2026 demo stack — environment
#
#   python tasks.py init      (creates .env from this file)
#
# .env is gitignored. Everything here is a local demo credential — none of it is
# a real secret — but keep it out of the repo anyway so nobody learns bad habits.
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=icc26

# ── Ignition ─────────────────────────────────────────────────────────────────
IGNITION_VERSION=8.3.8
IGNITION_ADMIN_USERNAME=admin
IGNITION_ADMIN_PASSWORD=password
IGNITION_EDITION=standard
IGNITION_HTTP_PORT=8088
IGNITION_HTTPS_PORT=8043
# `seed` generates a machine-local self-signed certificate and trusts it for
# the current user on Windows or macOS. localhost plus this machine's
# hostname/FQDN are always included. Add stable names/IPs used by other
# conference devices before seeding (comma-separated); IPs acquired later
# cannot match this cert.
IGNITION_SSL_COMMON_NAME=localhost
IGNITION_SSL_DNS_NAMES=
IGNITION_SSL_IP_ADDRESSES=
IGNITION_SSL_TRUST_HOST=true
TZ=America/Chicago

# HTTPS API key (:8043) — used by `tasks.py scan` / `trial` after enable-ssl.
# Paste the complete name:secret value generated by the Gateway UI. Grant the
# API security level Gateway read/write access and require a secure channel.
IGNITION_API_TOKEN_HTTPS=

# UID/GID the Ignition process runs as inside the container (image default 2003).
# Only matters when bind-mounting config-as-code from a host filesystem that
# enforces ownership, i.e. native Linux -- set these to your own `id -u` / `id -g`
# there or the gateway cannot write back. Docker Desktop on Windows and macOS
# fakes ownership, so the defaults are fine.
# See docs/00-architecture.md § Host platforms.
IGNITION_UID=2003
IGNITION_GID=2003

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_VERSION=17-alpine
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Database used by `tasks.py health`.
POSTGRES_DEMO_DB=icc26
#
# The per-role logins (ignition / icc26 / cdc) are NOT here. They are created by
# compose/postgres/initdb/01-databases.sql, which runs once against an empty
# volume and is the single source of truth for them. Variables duplicating those
# values used to live here and were read by nothing -- editing them changed no
# behaviour, which is worse than not having them. Change a password in the SQL
# and `nuke`, or ALTER ROLE on a running database.
# The one exception is ICC26_DB_PASSWORD below, which the *gateway* needs in
# order to log in, and so has to reach the container.

# ── Secrets the gateway reads ────────────────────────────────────────────────
#
# These env vars are available inside the ignition container, but the committed
# Cirrus/OPC config currently stores passwords as `"type": "Embedded"` ciphertext
# (see docs/00-architecture.md). Ignition 8.3.8 has no environment-variable
# Secret Provider, so these names are *not* looked up by config today — they are
# kept for a possible future provider and so ICC26_DB_PASSWORD is ready when the
# JDBC datasource is created. Portability of Embedded ciphertext across clones
# is still being proven (see docs/plans/00-status.md).
#
# The MQTT values must match compose/chariot/mqtt-users.json; ICC26_DB_PASSWORD
# must match the icc26 role in compose/postgres/initdb/01-databases.sql.
MQTT_ENGINE_PASSWORD=ign-engine
MQTT_TRANSMISSION_PASSWORD=ign-transmission
MQTT_DISTRIBUTOR_PASSWORD=password
ICC26_DB_PASSWORD=icc26

# ── Chariot MQTT Server ──────────────────────────────────────────────────────
# Pinned, not `latest`: an image that silently moves under the team -- or the
# night before the talk -- is not worth the convenience.
CHARIOT_VERSION=3.0.1
CHARIOT_ADMIN_PASSWORD=password
CHARIOT_MQTT_PORT=1883
# If the stack fails to start with "ports are not available ... An attempt was
# made to access a socket in a way forbidden by its access permissions", the
# host port is reserved by the OS, not in use by another process. On Windows,
# check with:  netsh interface ipv4 show excludedportrange protocol=tcp
# 8883/8884 land inside a reserved range on at least one dev machine here; the
# fix is to move the HOST side only and leave the container port alone --
# Chariot still serves MQTTS on 8883 internally. Same applies to any other port
# in this file. 18883 is the default for exactly that reason: it is outside the
# Windows reserved range and harmless on macOS and Linux.
CHARIOT_MQTTS_PORT=18883
CHARIOT_WS_PORT=8090
# Host port for Chariot's web UI. 8081 to stay clear of Ignition on 8088 and
# anything else you may already have on 8080.
CHARIOT_HTTP_PORT=8081
CHARIOT_HTTPS_PORT=8444

# ── Pattern 3: simulated Countess 3 FL cell counter (OPC UA) ─────────────────
# Ignition reaches this at opc.tcp://opcua-countess:4840/countess/ over the
# compose network; the published port is only for UaExpert or a probe script on
# the host. 4840 is the OPC UA default and is not in the Windows reserved range.
OPCUA_COUNTESS_PORT=4840
# Seconds between free-running counts. The StartCount method triggers one
# immediately regardless -- that is the stage trigger.
COUNTESS_COUNT_INTERVAL_S=180
COUNTESS_FIRST_COUNT_DELAY_S=15
# How long a count takes is NOT configurable -- it is RUN_DURATION_S in app.py, fixed at 5 s.
# The real Countess 3 FL takes under 30 s (Appendix B); 5 keeps the demo moving.
# Light cube slots. Leaving cube 2 empty is deliberate: its result fields then
# sit at Bad_NoData beside cube 1's real values, which is the demo's
# absent-vs-zero point. See docs/reference/countess-3fl-opcua-model.md § 8.
COUNTESS_CUBE1_INSTALLED=true
COUNTESS_CUBE2_INSTALLED=false
# Every Nth count runs brightfield-only despite a cube being fitted, so a node
# that had a value last count goes Bad_NoData on this one. 0 disables.
COUNTESS_BF_ONLY_EVERY_N=4
COUNTESS_LOG_LEVEL=INFO
# Set to INFO to log every node a client subscribes to. This is how you tell whether an
# Ignition OPC tag actually bound -- a misconfigured tag reads Error_Configuration in the tag
# browser and logs NOTHING gateway-side, so the OPC server is the only witness. Very noisy.
COUNTESS_ASYNCUA_LOG_LEVEL=WARNING

# ── Pattern 3: simulated Nova BioProfile FLEX2 bioanalyzer (OPC UA) ──────────
# The second analyzer, and it runs ALONGSIDE the Countess, not instead of it.
# The FLEX2 has a real vendor OPC UA server and this container reproduces the
# address space its manual documents -- flat OPCSystemObjects/OPCSystemCommands
# trees, no completion counter, no events, no methods. The Countess is the model
# we would design; this is what a vendor ships. Both on stage is the argument.
# See docs/reference/novaflex2-opcua-model.md.
#
# 4841 host-side because the Countess already holds 4840; inside the compose
# network both listen on 4840 and Ignition never sees these numbers.
OPCUA_NOVAFLEX_PORT=4841
NOVAFLEX_ANALYZER_ID=FLEX2-01
# Seconds between free-running analyses. Any of the vendor's own *ScheduleAnalysis
# command bits triggers one immediately -- that is the stage trigger, and it is
# the instrument's, not something we added.
NOVAFLEX_SAMPLE_INTERVAL_S=120
NOVAFLEX_FIRST_SAMPLE_DELAY_S=15
# How long an analysis takes is NOT configurable -- RUN_DURATION_S in app.py, fixed at 8 s
# (QC 5 s). A real FLEX2 running the full panel takes several minutes.
# The osmometer stays unfitted on purpose: Osmo->Result then reads Bad_NoData
# beside Good chemistry values in the same result at the same timestamp, while
# the vendor's own ModuleInformation->Modules->Osmo reads False, Good. That is
# absent-vs-zero said three ways. Same reason bank B of the autosampler is off.
# See docs/reference/novaflex2-opcua-model.md § 8.
NOVAFLEX_OSMO_INSTALLED=false
NOVAFLEX_AUTOSAMPLER_BANK_B=false
# Every Nth free-running cycle runs an onboard QC instead of a sample. QC writes
# QCResults and increments QcCompleteCounter -- never the sample counter. That is
# the manual's own section 9 warning made visible. 0 disables.
NOVAFLEX_QC_EVERY_N=6
# Per-analyte sensor failure. The sample still completes and still increments the
# counter -- one bad sensor does not void a run -- but that analyte reads Bad with
# ErrorStatus text beside it. Distinct from a whole-analysis dispense timeout,
# which does NOT increment (FAILURE_RATE, or the InjectFailure extension bit).
NOVAFLEX_SENSOR_ERROR_RATE=0.0
# Separator inside every string NodeId. The manual prints the arrow inside the
# identifier itself but also prints a spurious leading "<-" on every row, so it
# is genuinely ambiguous and only a live instrument settles it. Change this and
# the node_sep parameter on the bioanalyzer UDT together -- nothing else.
NOVAFLEX_NODE_SEPARATOR=->
NOVAFLEX_LOG_LEVEL=INFO
NOVAFLEX_ASYNCUA_LOG_LEVEL=WARNING

# ── Patterns 1 & 2: smart sample valve assembly (RFID badge -> sample valve) ──
# ONE device in TWO firmwares, and the pair is the whole point. Identical badge
# roster, identical interlock, identical stroke times -- valve.py and webui.py
# are byte-for-byte the same file in both build contexts. Everything that
# differs between the two containers is a difference the protocol caused.
#
# Each container serves the device's own commissioning webpage. Open both and
# read them side by side: on 8085 the topic is a text box, the QoS is a dropdown
# and Retained is a checkbox; on 8086 all three are disabled, because Sparkplug
# already decided. That comparison is as much of the talk as the MQTT traffic.
#
# Both valves are PUBLISH-ONLY. Nothing on the backbone opens either of them.
# See docs/plans/01-native-mqtt.md and docs/plans/02-sparkplug-b.md.

# -- shared: the physical assembly, identical in both --
VALVE_BROKER_HOST=chariot
VALVE_BROKER_PORT=1883
# id:holder:role:status, comma separated. status is authorized | not-authorized
# | training-expired; anything not on this list is badge-unknown. The default
# deliberately carries one badge refused for its role and one whose training
# lapsed, so both denial paths can be shown without editing anything on stage.
VALVE_BADGE_ROSTER=B-1042:Jordan Reyes:qc-analyst:authorized,B-2087:Sam Okafor:maintenance:not-authorized,B-3311:Alex Chen:qc-analyst:training-expired
# How long the valve stays open once a badge is accepted.
VALVE_SAMPLE_WINDOW_S=12
VALVE_TELEMETRY_INTERVAL_S=5
# Free-running background scans, so the firehose is not empty between triggers.
# SET THIS TO 0 for a scripted stage run -- then the only scan on the wire is
# the badge button you press yourself.
VALVE_SCAN_INTERVAL_S=90

# -- pattern 1: plain MQTT 3.1.1 --
VALVE_MQTT_UI_PORT=8085
VALVE_MQTT_USERNAME=sample-valve-01
VALVE_MQTT_PASSWORD=sample-valve-01
VALVE_DEVICE_ID=sample-valve-01
VALVE_CELL=br-201
# FACTORY DEFAULTS ONLY. These three are what the config page edits, and whatever
# is saved there is persisted to the valve-mqtt-config volume and wins over these
# on the next start. Changing them does nothing to a device already commissioned
# once -- `python tasks.py nuke` is what returns it to factory.
VALVE_BASE_TOPIC=icc26/site1/upstream/br-201/sample-valve-01
VALVE_PUBLISH_QOS=1
VALVE_PUBLISH_RETAIN=true
VALVE_LOG_LEVEL=INFO

# -- pattern 2: Sparkplug B v3.0.0 --
VALVE_SPB_UI_PORT=8086
VALVE_SPB_MQTT_USERNAME=sample-valve-02
VALVE_SPB_MQTT_PASSWORD=sample-valve-02
# The only three commissionable fields, and note what they are NOT: a topic, a
# QoS or a retained flag. They are names inside a namespace somebody else fixed.
# Same volume caveat as above (valve-spb-config).
VALVE_SPB_GROUP_ID=ICC26-Site1-UPSTREAM
VALVE_SPB_EDGE_NODE_ID=SAMPLE-VALVE-02
VALVE_SPB_DEVICE_ID=SV-202
VALVE_SPB_CELL=br-202
# Name + alias in the birth certificate, alias alone in DDATA -- what Cirrus's
# own Transmission does. Set false to put the names back on the wire and watch
# the payload grow; it also shows why a consumer that missed DBIRTH is lost, and
# therefore why Rebirth exists.
VALVE_SPB_USE_ALIASES=true
VALVE_SPB_LOG_LEVEL=INFO

# ── Pattern 4: the SAME FLEX2, with a callback URL and nothing else ──────────
# A separate container from opcua-novaflex, so pattern 4 cannot disturb pattern
# 3. The price is two independent sample lifecycles: the same physical sample
# cannot appear on the topic twice by construction. The id FORMAT matches
# (S-#####) and SAMPLE_ID_START is the knob for lining the two counters up by
# hand before a run where you want one id under both mechanisms. Nothing
# automates it. See docs/04-novaflex-webhook.md § Deviations.
#
# Device page on :8084 — 8085/8086 are the valves, 8000 was the retired LIMS.
WEBHOOK_NOVAFLEX_UI_PORT=8084
WEBHOOK_NOVAFLEX_DEVICE_ID=novaflex-01
WEBHOOK_NOVAFLEX_ANALYZER_ID=FLEX2-01
# FACTORY DEFAULTS. The device page overrides all three live and does NOT
# persist the override — a restart puts the instrument back to these. That is
# the opposite of the valves, deliberately: a commissioned topic should survive
# a restart, a stage control should not.
WEBHOOK_NOVAFLEX_ENABLED=true
# The Event Stream HTTP source URL. THIS PATH IS A GUESS and is the first thing
# to check on a live gateway — the Event Stream's own config panel prints the
# real one. See the runbook in docs/04-novaflex-webhook.md.
# HTTPS: the container trusts the mounted gateway certificate and skips only
# hostname matching, because seed's ssl.pfx SAN is localhost, not `ignition`.
# Verification is never disabled.
WEBHOOK_NOVAFLEX_URL=https://ignition:8043/system/eventstream/icc-2026/04_webhook/novaflex-result
# Must match SECRET in the webhook_event script module. Change one, change both,
# then `python tasks.py scan`.
WEBHOOK_NOVAFLEX_SECRET=icc26-webhook-secret
WEBHOOK_NOVAFLEX_TIMEOUT_S=10
WEBHOOK_NOVAFLEX_SAMPLE_ID_PREFIX=S-
WEBHOOK_NOVAFLEX_SAMPLE_ID_START=1
# Osmo unfitted, same as the OPC UA twin. On this path absence shows up as a key
# that is simply not in the JSON, beside Modules.Osmo=false which is. Absent and
# "deliberately not measured" are different statements and both are on the wire.
WEBHOOK_NOVAFLEX_OSMO_INSTALLED=false
WEBHOOK_NOVAFLEX_SAMPLE_INTERVAL_S=120
WEBHOOK_NOVAFLEX_FIRST_SAMPLE_DELAY_S=20
# Every Nth free-running cycle is an onboard QC. A QC POSTs nothing, which is
# checkpoint 5 and matches pattern 3's silence on the same event. 0 disables.
WEBHOOK_NOVAFLEX_QC_EVERY_N=6
WEBHOOK_NOVAFLEX_SENSOR_ERROR_RATE=0.0
# Whole-analysis dispense timeout. No POST at all. The device page has a button
# for the one-shot version, which is the one to use on stage.
WEBHOOK_NOVAFLEX_FAILURE_RATE=0.0
WEBHOOK_NOVAFLEX_LOG_LEVEL=INFO

# ── Extra: LIMS approval webhook — UNWIRED 2026-08-23 ────────────────────────
# The `lims` service is commented out of docker-compose.yml and `lims-bridge` is
# gone from compose/chariot/mqtt-users.json. These variables are kept because
# the LIMS is pattern 4's proven fallback: a WebDev doPost publishing through
# system.cirruslink.transmission was broker-verified on 2026-08-20, and it is
# file-authorable, which the Event Stream HTTP source may turn out not to be.
# Uncommenting the compose block is all it takes to bring it back.
# Docs: docs/extra/lims-webhook-spec.md.
LIMS_PORT=8000
LIMS_WEBHOOK_URL=https://ignition:8043/system/webdev/icc-2026/lims/sample-result
LIMS_WEBHOOK_SECRET=icc26-webhook-secret
LIMS_WEBHOOK_MAX_ATTEMPTS=5
LIMS_GENERATOR_INTERVAL_S=0
LIMS_LOG_LEVEL=INFO

