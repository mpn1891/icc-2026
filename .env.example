# ─────────────────────────────────────────────────────────────────────────────
# ICC 2026 demo stack — environment
#
#   python tasks.py init      (creates .env from this file)
#
# .env is gitignored. Everything here is a local demo credential — none of it is
# a real secret — but keep it out of the repo anyway so nobody learns bad habits.
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=icc26

# ── Ignition ─────────────────────────────────────────────────────────────────
IGNITION_VERSION=8.3.8
IGNITION_ADMIN_USERNAME=admin
IGNITION_ADMIN_PASSWORD=password
IGNITION_EDITION=standard
IGNITION_HTTP_PORT=8088
IGNITION_HTTPS_PORT=8043
TZ=America/Chicago

# Needed by `tasks.py scan`, which is how a pulled config change reaches the
# gateway. Ignition 8.3 rejects the admin password on its /data/api/v1 routes
# and wants an API key instead: Gateway UI > Platform > Security > API Keys.
# Over plain HTTP you must also turn off "Require secure connections for API
# Keys". Per machine, so leave it blank here and fill it in your own .env.
# Without it, apply pulled changes with `python tasks.py restart ignition`.
IGNITION_API_TOKEN=

# UID/GID the Ignition process runs as inside the container (image default 2003).
# Only matters when bind-mounting config-as-code from a host filesystem that
# enforces ownership, i.e. native Linux -- set these to your own `id -u` / `id -g`
# there or the gateway cannot write back. Docker Desktop on Windows and macOS
# fakes ownership, so the defaults are fine.
# See docs/00-architecture.md § Host platforms.
IGNITION_UID=2003
IGNITION_GID=2003

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_VERSION=17-alpine
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Database used by `tasks.py health`.
POSTGRES_DEMO_DB=icc26
#
# The per-role logins (ignition / icc26 / cdc) are NOT here. They are created by
# compose/postgres/initdb/01-databases.sql, which runs once against an empty
# volume and is the single source of truth for them. Variables duplicating those
# values used to live here and were read by nothing -- editing them changed no
# behaviour, which is worse than not having them. Change a password in the SQL
# and `nuke`, or ALTER ROLE on a running database.
# The one exception is ICC26_DB_PASSWORD below, which the *gateway* needs in
# order to log in, and so has to reach the container.

# ── Secrets the gateway reads ────────────────────────────────────────────────
#
# These env vars are available inside the ignition container, but the committed
# Cirrus/OPC config currently stores passwords as `"type": "Embedded"` ciphertext
# (see docs/00-architecture.md). Ignition 8.3.8 has no environment-variable
# Secret Provider, so these names are *not* looked up by config today — they are
# kept for a possible future provider and so ICC26_DB_PASSWORD is ready when the
# JDBC datasource is created. Portability of Embedded ciphertext across clones
# is still being proven (see docs/plans/00-status.md).
#
# The MQTT values must match compose/chariot/mqtt-users.json; ICC26_DB_PASSWORD
# must match the icc26 role in compose/postgres/initdb/01-databases.sql.
MQTT_ENGINE_PASSWORD=ign-engine
MQTT_TRANSMISSION_PASSWORD=ign-transmission
MQTT_DISTRIBUTOR_PASSWORD=password
ICC26_DB_PASSWORD=icc26

# ── Chariot MQTT Server ──────────────────────────────────────────────────────
# Pinned, not `latest`: an image that silently moves under the team -- or the
# night before the talk -- is not worth the convenience.
CHARIOT_VERSION=3.0.1
CHARIOT_ADMIN_PASSWORD=password
CHARIOT_MQTT_PORT=1883
# If the stack fails to start with "ports are not available ... An attempt was
# made to access a socket in a way forbidden by its access permissions", the
# host port is reserved by the OS, not in use by another process. On Windows,
# check with:  netsh interface ipv4 show excludedportrange protocol=tcp
# 8883/8884 land inside a reserved range on at least one dev machine here; the
# fix is to move the HOST side only and leave the container port alone --
# Chariot still serves MQTTS on 8883 internally. Same applies to any other port
# in this file. 18883 is the default for exactly that reason: it is outside the
# Windows reserved range and harmless on macOS and Linux.
CHARIOT_MQTTS_PORT=18883
CHARIOT_WS_PORT=8090
# Host port for Chariot's web UI. 8081 to stay clear of Ignition on 8088 and
# anything else you may already have on 8080.
CHARIOT_HTTP_PORT=8081
CHARIOT_HTTPS_PORT=8444
