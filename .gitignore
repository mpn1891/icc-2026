# ─────────────────────────────────────────────────────────────────────────────
# Secrets and machine-local files
# ─────────────────────────────────────────────────────────────────────────────
.env
*.gwbk
**/certificates/*
**/keystore/
docker-compose.override.yml

# Ignition instance-local config (machine-specific, never shared)
ignition/config/local/
ignition/config/resources/local/
# API key profiles (tokenHash + name). Each machine creates its own in the
# Gateway UI and puts name:secret in gitignored .env — do not share via git.
ignition/config/resources/core/ignition/api-token/

# MQTT tag trees the modules build for themselves, from traffic. Both of MQTT
# Engine's ingest surfaces produce one: Sparkplug edge nodes land under
# "Edge Nodes/", and a Custom Namespace subscription auto-creates a tree shaped
# like the JSON payload's topic — for us "MQTT Engine/icc26/...".
# Not configuration: the modules rebuild them at runtime, and they are keyed to
# whatever traffic that particular machine has seen. Committing them means every
# gateway churns another machine's leftovers into every diff.
# NB: these are anchored paths, so "MQTT Engine/Engine Info/Edge Nodes/" -- a
# static folder with no per-node children -- stays tracked, as it should.
ignition/config/resources/core/ignition/tag-definition/MQTT Engine/Edge Nodes/
ignition/config/resources/core/ignition/tag-definition/MQTT Engine/icc26/
ignition/config/resources/core/ignition/tag-definition/MQTT Transmission/Transmission Info/Transmitters/*/Edge Nodes/

# ─────────────────────────────────────────────────────────────────────────────
# Ignition 8.3 runtime state
#
# We bind-mount live gateway directories into this repo, so the gateway writes
# here continuously. Only data/config and data/projects are source; everything
# below is runtime state and must never be committed.
# Derived from Inductive Automation's 8.3 version-control guide.
# ─────────────────────────────────────────────────────────────────────────────
**/db/*
**/metricsdb/*
**/autobackup/*
**/db_backup_sqlite.idb
**/valueStore.idb
**/jar-cache/*
**/var/
**/logs/
*.log
**/request*
**/response*
*.tmp
*.bak
**/.resources/
**/projects/conversion-report.txt
**/migration-log-*.md

# ─────────────────────────────────────────────────────────────────────────────
# Third-party modules — licensed binaries, fetched per compose/ignition/MODULES.md
# ─────────────────────────────────────────────────────────────────────────────
compose/ignition/modules/*.modl

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ─────────────────────────────────────────────────────────────────────────────
# Large reference dumps (local only; agents can still read by path)
# ─────────────────────────────────────────────────────────────────────────────
ignition/reference/openapi.json

# ─────────────────────────────────────────────────────────────────────────────
# Editors / OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
